  "findings": [
    {
      "id": "FINDING-01",
      "topic": "Production Human Authentication",
      "severity": "MEDIUM",
      "description": "DevelopmentHumanApprovalAdapter uses local dictionary lookup with plaintext passwords. It does not integrate with Enterprise SSO (SAML 2.0 / OAuth2 / WebAuthn).",
      "blocks_phase5": false,
      "blocks_production": true
    },
    {
      "id": "FINDING-02",
      "topic": "Development Adapter Isolation",
      "severity": "INFO",
      "description": "The development adapter is cleanly isolated and not exposed as an MCP tool; an AI agent cannot call it over stdio JSON-RPC.",
      "blocks_phase5": false,
      "blocks_production": false
    },
    {
      "id": "FINDING-03",
      "topic": "HMAC Correctness",
      "severity": "INFO",
      "description": "Uses standard HS256 with constant-time comparison (hmac.compare_digest) and Base64URL encoding.",
      "blocks_phase5": false,
      "blocks_production": false
    },
    {
      "id": "FINDING-04",
      "topic": "Secret Provisioning",
      "severity": "LOW",
      "description": "Secret loaded via environment variable; fails closed if missing. Lack of kid header prevents seamless key rotation.",
      "blocks_phase5": false,
      "blocks_production": false
    },
    {
      "id": "FINDING-05",
      "topic": "Proposal Immutability",
      "severity": "INFO",
      "description": "Proposal fields are hashed into a deterministic SHA-256 digest; post-approval tampering causes immediate verification failure.",
      "blocks_phase5": false,
      "blocks_production": false
    },
    {
      "id": "FINDING-06",
      "topic": "Payload Hash Completeness",
      "severity": "INFO",
      "description": "Canonical payload hash covers machine_id, recommendation, evidence, alert_id, and confidence.",
      "blocks_phase5": false,
      "blocks_production": false
    },
    {
      "id": "FINDING-07",
      "topic": "Token Expiry",
      "severity": "INFO",
      "description": "Enforces 15-minute default validity with 5-second clock skew tolerance using UTC timestamps.",
      "blocks_phase5": false,
      "blocks_production": false
    },
    {
      "id": "FINDING-08",
      "topic": "Persistent Replay Prevention",
      "severity": "INFO",
      "description": "Persistently recorded in consumed_tokens table with JTI primary key constraint; survives process restarts.",
      "blocks_phase5": false,
      "blocks_production": false
    },
    {
      "id": "FINDING-09",
      "topic": "Concurrent Ticket Creation",
      "severity": "INFO",
      "description": "Verified that race conditions result in exactly 1 successful ticket creation and 1 failure.",
      "blocks_phase5": false,
      "blocks_production": false
    },
    {
      "id": "FINDING-10",
      "topic": "Transaction Atomicity",
      "severity": "LOW",
      "description": "Two commit points exist between ticket_service and tool handler; unifying inside a single begin block is recommended.",
      "blocks_phase5": false,
      "blocks_production": false
    },
    {
      "id": "FINDING-11",
      "topic": "Migration Integrity",
      "severity": "INFO",
      "description": "Alembic revision c742f9a1e0b5 creates only ticket_proposals and consumed_tokens; fully reversible downgrade.",
      "blocks_phase5": false,
      "blocks_production": false
    },
    {
      "id": "FINDING-12",
      "topic": "MCP Bypass Possibilities",
      "severity": "INFO",
      "description": "Exactly 9 tools registered; input schemas use extra='forbid'; approved_by is strictly rejected from agent.",
      "blocks_phase5": false,
      "blocks_production": false
    },
    {
      "id": "FINDING-13",
      "topic": "Git File-List Discrepancy",
      "severity": "INFO",
      "description": "Discrepancy resolved: MCP server and test files were untracked additions in Phase 4; only models/__init__.py existed in baseline HEAD.",
      "blocks_phase5": false,
      "blocks_production": false
    },
    {
