        "window": {
          "type": "string",
          "required": false,
          "default": null
        },
        "include_explainability": {
          "type": "boolean",
          "required": false,
          "default": false
        }
      },
      "ml_model_integration": {
        "isolation_forest": {
          "frozen_threshold": 0.0269,
          "modality": "tabular point-in-time anomaly scoring",
          "score_formula": "-decision_function(X)"
