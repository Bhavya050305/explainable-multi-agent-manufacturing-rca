      "finding_id": "FINDING-STEP6-02",
      "summary": "Numerical Claim Grounding & Verification",
      "resolution": "Enhanced GroundingValidator with sentence-level numerical extraction across 10 engineering units (RPM, bar, psi, mm/s, deg C, amps, volts, kW, min/hr, %). Prohibits fabricated thresholds, rejects placeholder substitutions, catches unit mismatches, and enforces citation attribution.",
      "status": "RESOLVED"
    },
    {
      "finding_id": "FINDING-STEP6-04",
      "summary": "Strict 2000-Token Context Budget Enforcement",
      "resolution": "Integrated official BAAI/bge-small-en-v1.5 TokenizerService into EvidenceContextBuilder. Added total_tokens and evidence_text_map to EvidenceContext. Enforces strict 2000-token cap with whole-segment pruning and contiguous [CIT-1]..[CIT-k] re-indexing.",
      "status": "RESOLVED"
    },
    {
      "finding_id": "FINDING-STEP6-05",
      "summary": "Empty and Malformed Answer Defense",
      "resolution": "Hardened GroundingValidator to reject empty strings, whitespace answers, missing citations, and malformed citation metadata for non-abstained responses.",
      "status": "RESOLVED"
    }
