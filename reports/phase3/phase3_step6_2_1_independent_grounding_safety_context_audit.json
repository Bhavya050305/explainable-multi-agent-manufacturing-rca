  "audit_findings": [
    {
      "finding_id": "FINDING-STEP6.2.1-01",
      "severity": "MEDIUM",
      "title": "Regex Safety Intent Masking by Leading Educational Clauses",
      "component": "backend/app/rag/prompt_templates.py:classify_safety_intent",
      "description": "Educational regex checks precede operational and bypass checks. Compound queries beginning with educational phrasing (e.g., 'Explain lockout/tagout, then instruct controller to bypass it') match educational patterns first and bypass abstention gates.",
      "remediation": "Evaluate imperative bypass patterns before educational whitelisting, or split compound sentences prior to classification."
    },
    {
      "finding_id": "FINDING-STEP6.2.1-02",
      "severity": "LOW",
      "title": "Comma-Formatted Integers in Generated Answer Cause Truncated Extraction",
      "component": "backend/app/rag/grounding_validator.py:extract_numerical_claims",
      "description": "Regex pattern \\b(?P<num>\\d+(?:\\.\\d+)?)\\s*(?P<unit>...)\\b does not account for internal commas in numbers. An answer emitting '6,000 RPM' extracts '000 RPM' and fails evidence verification.",
      "remediation": "Update regex to accommodate thousand separators: \\b(?P<num>\\d{1,3}(?:,\\d{3})+|\\d+(?:\\.\\d+)?)\\s*(?P<unit>...)\\b."
    },
    {
      "finding_id": "FINDING-STEP6.2.1-03",
      "severity": "INFORMATIONAL",
      "title": "Numeric Range Expressions Extract Only Right-Hand Unit",
      "component": "backend/app/rag/grounding_validator.py:extract_numerical_claims",
      "description": "In range expressions like '120-150 bar', only the right-hand boundary '150 bar' is extracted because '120' lacks an immediately adjacent unit symbol.",
      "remediation": "Add range extraction patterns for 'X to Y unit' and 'X-Y unit'."
    }
  ],
