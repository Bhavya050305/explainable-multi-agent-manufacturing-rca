  "outstanding_defects_and_limitations": {
    "defects": [
      {
        "defect_id": "DEFECT-01",
        "severity": "Low (provisional evaluation assessment; not a formally approved operational risk classification)",
        "category": "Input Schema Validation",
        "status": "OPEN",
        "location": "backend/app/ml/inference/schemas.py:86-94 (SequenceWindowInput.validate_sequence_structure)",
        "description": "Chronological monotonicity is only evaluated when len(timestamps) == len(self.readings). Sequences with partial timestamps (e.g. 29 timestamps and 1 None) bypass monotonicity checking without raising an error.",
        "remediation_plan": "Phase 3 schema hardening to enforce all-or-nothing timestamp arrays."
      }
    ],
    "architectural_limitations": [
      {"id": "LIM-01", "name": "In-process lock serialization for Keras and SHAP in single-worker processes"},
      {"id": "LIM-02", "name": "Cold-Start Latency", "description": "A composite cold-start observation of approximately 6.04 seconds was recorded. C-library initialization was considered a possible contributing factor, but the benchmark instrumentation did not conclusively establish the cause."},
      {"id": "LIM-03", "name": "Passive synchronous timeouts cannot preempt running C-extensions mid-execution"},
      {"id": "LIM-04", "name": "Process-local singleton model registry requires multi-process architecture for horizontal scaling"},
      {"id": "LIM-05", "name": "Zero-Shot Holdout Generalization", "description": "Exploratory zero-shot machine holdout testing produced lifetime recall between 48.86% and 76.14% across the four unseen faulted machines. Incipient-stage recall was lower, approximately 25%–55%, while severe-stage recall was 100% in the reported synthetic experiment."}
    ]
  },
  "scientific_limitations_and_negative_claims": {
    "mandatory_disclosures": [
      "The sensor dataset is purely synthetic, generated via scripted formulas in generate_sensor_data.py.",
      "Only 10 machines are represented, constituting experimental pseudoreplication.",
      "Four fault types are coupled 1-to-1 with four specific machine IDs, completely confounding machine identity and fault type.",
      "Fault progressions follow programmed linear/polynomial trends added to Gaussian noise, not natural physical degradation.",
      "Fault dynamics activate at the exact fixed timestep 2600 across all faulted machines.",
